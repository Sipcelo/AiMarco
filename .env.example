# ─────────────────────────────────────────────────────────────
# AiMarco V1 — .env.example (raiz) — SEGURO PARA VERSIONAR
# Copie para `.env` e preencha com valores reais. NÃO commitar o .env.
# ─────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────
PORT=3333
NODE_ENV=development                          # development | production | test

# ─── Supabase (OBRIGATÓRIO) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ NUNCA expor ao client-side!
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# ─── WhatsApp API (opcional — default "pending") ──────
WHATSAPP_API_URL=http://localhost:8080/message/sendText/InstanceName
WHATSAPP_API_KEY=your-api-key

# ─── Gemini API (opcional — default "pending") ────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Web / Frontend ───────────────────────────────────
VITE_API_URL=http://localhost:3333
