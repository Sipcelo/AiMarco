# URL base da API do backend
# Desenvolvimento local: http://localhost:3333
# Producao (Railway):   https://aimarco.up.railway.app
#
# No Railway, configure esta variavel em:
#   Project → Service (web) → Variables → VITE_API_URL=https://aimarco.up.railway.app
#
# Se nao definida, o app usa https://aimarco.up.railway.app como fallback.
VITE_API_URL=http://localhost:3333