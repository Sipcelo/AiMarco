{
  "expo": {
    "name": "AiMarco",
    "slug": "aimarco",
    "scheme": "aimarco",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.aimarco.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7FB"
      }
    },
    "extra": {
      "apiUrl": "https://aimarco.up.railway.app",
      "eas": {
        "projectId": "7d433ee5-650e-4824-a72e-0241f2ecabcf"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#007AFF",
          "defaultChannel": "agendamentos"
        }
      ]
    ],
    "owner": "sipceloo"
  }
}
