# ─── Server ───────────────────────────────────────────
PORT=3333
NODE_ENV=development                          # development | production | test

# ─── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ NUNCA expor ao client-side!
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# ─── WhatsApp API (Evolution API or generic) ──────────
WHATSAPP_API_URL=http://localhost:8080/message/sendText/InstanceName
WHATSAPP_API_KEY=your-api-key

# ─── Gemini API (AI message generation) ───────────────
GEMINI_API_KEY=your-gemini-api-key
